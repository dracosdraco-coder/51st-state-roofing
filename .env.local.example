# ============================================================================
# 51st State Construction - Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in your values
# ============================================================================

# ============================================================================
# Google Analytics & Google Tag Manager
# ============================================================================
# GTM Container ID — from tagmanager.google.com
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
# GA4 Measurement ID — from Analytics > Admin > Data Streams
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
# Google Ads Account ID — from ads.google.com > Tools > Conversions (AW-XXXXXXXXX format)
NEXT_PUBLIC_GOOGLE_ADS_ID=AW-XXXXXXXXX
# Conversion label for form/lead submissions — from your Ads conversion action
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL_LEAD=XXXXXXXXXXX

# Google Places API for address autocomplete in estimator
GOOGLE_PLACES_API_KEY=YOUR_GOOGLE_PLACES_API_KEY

# Google Maps Embed API for ServiceAreaMap component
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# ============================================================================
# Facebook Pixel
# ============================================================================
NEXT_PUBLIC_FB_PIXEL_ID=XXXXXXXXXXXXXXX

# ============================================================================
# CallRail (Phone Tracking & Number Swapping)
# ============================================================================
NEXT_PUBLIC_CALLRAIL_ACCOUNT_ID=XXXXXXXXXXXXXXX
NEXT_PUBLIC_CALLRAIL_PAID=XXXXXXXXXXXXXXX
NEXT_PUBLIC_CALLRAIL_ORGANIC=XXXXXXXXXXXXXXX

# ============================================================================
# Sanity CMS
# ============================================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=YOUR_SANITY_PROJECT_ID
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=YOUR_SANITY_API_TOKEN

# ============================================================================
# Lead Management — Multi-Destination Pipeline
# ============================================================================
# Projex CRM Webhook URL
NEXT_PUBLIC_PROJEX_WEBHOOK_URL=https://api.projexcrm.com/webhooks/leads

# Google Sheets (Apps Script web app URL — paste after deploying your Apps Script)
GOOGLE_SHEETS_WEBHOOK_URL=https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec

# UCM Webhook URL
UCM_WEBHOOK_URL=https://YOUR_UCM_ENDPOINT/webhook

# Google Business Profile Location IDs (from GBP dashboard → Business info → Location ID)
GOOGLE_BUSINESS_LOCATION_ID_NC=YOUR_GBP_LOCATION_ID_NC
GOOGLE_BUSINESS_LOCATION_ID_FL=YOUR_GBP_LOCATION_ID_FL

# Resend API for transactional emails (optional)
RESEND_API_KEY=YOUR_RESEND_API_KEY

# ============================================================================
# Site Configuration
# ============================================================================
NEXT_PUBLIC_SITE_URL=https://51stateconstruction.com

# ============================================================================
# Notes
# ============================================================================
# NEXT_PUBLIC_* variables are exposed to the browser
# Other variables are server-only

# For local development:
# 1. Google Analytics/GTM will still track development
# 2. Projex webhook will send test leads
# 3. Consider using test account IDs for development

# For production:
# 1. Replace all test IDs with production values
# 2. Ensure NEXT_PUBLIC_SITE_URL matches your domain
# 3. Set up proper CORS for Sanity API
